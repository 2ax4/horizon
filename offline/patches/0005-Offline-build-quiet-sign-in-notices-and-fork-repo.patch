From 8bdd15558b5468928ed738be1c5116408664e273 Mon Sep 17 00:00:00 2001
From: 2ax4 <2ax4@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:03:23 +0000
Subject: [PATCH 5/5] Offline build: quiet sign-in notices and fork repo

The no-client-id warning ("...so it can't start the game") read as if
the game cannot start at all: the constant now says sign-in is simply
not available, the sign-in dialog shows no error box without a client
id (Play offline stays), and the update check names the fork's
repository directly instead of the pre-rename address.
---
 launcher/src/account.rs    | 2 +-
 launcher/src/backend.rs    | 2 +-
 launcher/src/owner_page.rs | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/launcher/src/account.rs b/launcher/src/account.rs
index 6ab90e5..c5d3e77 100644
--- a/launcher/src/account.rs
+++ b/launcher/src/account.rs
@@ -21,7 +21,7 @@ use std::time::{Duration, SystemTime, UNIX_EPOCH};
 /// The keychain service name every secret is stored under.
 pub const SERVICE: &str = "dev.playhorizon.launcher";
 const SCOPE: &str = "XboxLive.signin offline_access";
-pub const NOT_CONFIGURED: &str = "This build of the launcher has no Microsoft sign-in (HORIZON_MSA_CLIENT_ID), so it can't start the game.";
+pub const NOT_CONFIGURED: &str = "Microsoft sign-in is not available in this build.";
 /// What every Play says while no account in the launcher owns the game.
 pub const NEEDS_OWNER: &str =
     "Sign in with a Microsoft account that owns Minecraft: Java Edition to play";
diff --git a/launcher/src/backend.rs b/launcher/src/backend.rs
index 5591ba1..e080f1c 100644
--- a/launcher/src/backend.rs
+++ b/launcher/src/backend.rs
@@ -10,7 +10,7 @@ use std::sync::mpsc::Sender;
 use std::sync::{Arc, Mutex};
 
 pub const REPO: &str = "horizon-rust/horizon";
-pub const LAUNCHER_REPO: &str = "2ax4/horizon";
+pub const LAUNCHER_REPO: &str = "2ax4/horizon-offline-auto-update";
 pub const README_URL: &str = "https://github.com/horizon-rust/horizon/blob/main/launcher/README.md";
 /// The players' page on connecting an AI agent (the website's docs/agents.md).
 pub const AGENT_DOCS_URL: &str = "https://playhorizon.dev/docs/agents";
diff --git a/launcher/src/owner_page.rs b/launcher/src/owner_page.rs
index 64823c7..d886a14 100644
--- a/launcher/src/owner_page.rs
+++ b/launcher/src/owner_page.rs
@@ -30,7 +30,7 @@ impl Launcher {
         // The screenshot preview shows a code without asking Microsoft for one.
         let state = match &self.sign_in_state {
             _ if sign_in_preview() => Shown::Code("https://www.microsoft.com/link", "K7Q-4MXR"),
-            _ if !configured => Shown::Error(tr(account::NOT_CONFIGURED)),
+            _ if !configured => Shown::Idle,
             Some(SignInState::Starting) => Shown::Starting("Asking Microsoft…"),
             Some(SignInState::Working(phase)) => Shown::Starting(phase.label()),
             Some(SignInState::Code(code)) => Shown::Code(&code.verification_uri, &code.user_code),
@@ -149,7 +149,7 @@ impl Launcher {
                 )
             }
             Shown::Starting(_) => None,
-            Shown::Error(_) if !configured => None,
+            _ if !configured => None,
             _ => Some(
                 microsoft::sign_in_button("owner-sign-in", &t).on_click(cx.listener(
                     |this, _: &ClickEvent, _, cx| {
-- 
