Subject: [PATCH 4/5] Offline build: quiet sign-in notices and fork repo

---
 launcher/src/backend.rs | 59 +++++++++++++++++++++++------------------
 1 file changed, 33 insertions(+), 26 deletions(-)

diff --git a/launcher/src/backend.rs b/launcher/src/backend.rs
index 6393b3ccc..0cb3abb04 100644
--- a/launcher/src/backend.rs
+++ b/launcher/src/backend.rs
@@ -10,6 +10,7 @@ use std::sync::mpsc::Sender;
 use std::sync::{Arc, Mutex};
 
 pub const REPO: &str = "horizon-rust/horizon";
+pub const LAUNCHER_REPO: &str = "2ax4/horizon-offline-auto-update";
 pub const README_URL: &str = "https://github.com/horizon-rust/horizon/blob/main/launcher/README.md";
 /// The players' page on connecting an AI agent (the website's docs/agents.md).
